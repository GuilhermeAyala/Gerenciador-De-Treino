generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    nome      String
    email     String
    senha     String
    workouts  Workout[]
    sessao    Sessao[]
}

model Exercicio {
    id             Int                @id @default(autoincrement())
    nome           String
    grupo_muscular String
    workouts       WorkoutExercicio[]
    sessao         SessaoExercicio[]
}

model Workout {
    id         Int                @id @default(autoincrement())
    nome       String
    user       User               @relation(fields: [userId], references: [id])
    userId     Int
    exercicios WorkoutExercicio[]
    sessao     Sessao[]
}

model WorkoutExercicio {
    id          Int       @id @default(autoincrement())
    workout     Workout   @relation(fields: [workoutId], references: [id])
    workoutId   Int
    exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
    exercicioId Int
    series      Int
    repeticoes  Int
    carga       Float
}

model Sessao {
    id         Int               @id @default(autoincrement())
    data       DateTime          @default(now())
    workout    Workout           @relation(fields: [workoutId], references: [id])
    workoutId  Int
    user       User              @relation(fields: [userId], references: [id])
    userId     Int
    exercicios SessaoExercicio[]
}

model SessaoExercicio {
    id          Int       @id @default(autoincrement())
    sessao      Sessao    @relation(fields: [sessaoId], references: [id])
    sessaoId    Int
    exercicio   Exercicio @relation(fields: [exercicioId], references: [id])
    exercicioId Int
    series      Int
    repeticoes  Int
    carga       Float
    feito       Boolean
}
